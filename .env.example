# Optional. By default pi-web-frq uses ~/Documents/Pi/Default for no-project sessions.
# Only set this when you explicitly want a different absolute default workspace.
# PI_WEB_WORKSPACE=C:\\Users\\YOUR_NAME\\Documents\\Pi\\Default

# Optional. Read/write/bash tools are enabled by default. Set false to disable write/edit/bash.
# PI_WEB_ALLOW_WRITES=false

# Optional listening port. The development and production scripts listen on all network interfaces.
PI_WEB_PORT=30142
